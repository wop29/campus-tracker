# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used only by scripts that need admin access (not by the app UI).
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic (server only). Without it, AI features show "not configured" and the rest of the app still works.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-5

# Daily email reminders (see docs/REMINDERS.md). All server only.
# Public base URL of the app, used for links in emails, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Long random string used to sign one-click unsubscribe links.
REMINDER_SECRET=
# Option A: Resend (free plan: 100 emails/day). REMINDER_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
REMINDER_FROM="MBA Planner <reminders@yourdomain.com>"
# Option B: SMTP, e.g. Gmail with an app password (about 500 emails/day). Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: max emails per run (default 100). Set REMINDER_HOURLY=1 only if an hourly scheduler calls the endpoint.
REMINDER_MAX_PER_RUN=
REMINDER_HOURLY=
